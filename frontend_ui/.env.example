# Base URL del core_management_api. La usa el httpClient (auth/login,
# controlService, predictionService) y debe apuntar al backend FastAPI.
VITE_CORE_API_URL=http://localhost:8001

# Edge Device API URL (Video Stream, Real-time Analysis)
VITE_EDGE_API_URL=http://localhost:8000

# Deprecated: ya no la lee nadie del código (controlService.ts ahora usa
# VITE_CORE_API_URL vía httpClient). Se mantiene como referencia histórica
# y se removerá en una limpieza posterior.
VITE_API_BASE_URL=http://localhost:8001

# TomTom Traffic Flow (track EXPERIMENTAL feature/tomtom, Fase A — front puro).
# Display key (NO secret): protegida por domain-whitelist + QPS en el dashboard
# de TomTom; va al bundle a propósito. Si se omite, la vista degrada con gracia
# (solo mapa base). IMPORTANTE: Vite lee este archivo desde frontend_ui/ — para
# `npm run dev` la key debe estar en frontend_ui/.env (NO en el .env raíz, que
# Vite no lee). En docker se inyecta como build-arg en docker-compose.yml.
VITE_TOMTOM_KEY=
