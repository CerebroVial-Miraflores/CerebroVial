.claude/settings.local.json
.claude/projects/
tmp_*.txt
tmp_*.py
.env
frontend_ui/.env
*.docx
!documentation/tesis/*.docx
.venv/
# Python build artifacts
*.egg-info/
*.egg-info
build/
dist/
__pycache__/
*.pyc
# Node.js deps de la raíz (frontend_ui/node_modules ya lo cubre frontend_ui/.gitignore).
/node_modules/
.DS_Store
**/.DS_Store
compose-*.log
# Logs de la siembra del calendario de congestión (scripts/seed_congestion_calendar.py).
logs/
videos/
# Clips de benchmark de visión (binarios reproducibles vía el README del dir).
# Se versionan el README y la metodología, NO los .mp4.
edge_device/benchmarks/clips/*.mp4
edge_device/benchmarks/clips/**/*.mp4
# Debris descartable (corridas SUMO, datasets crudos, calibración). Cuelga de repo-root.
# Lo versionable se promueve fuera de scratch/ (p.ej. simulation/data/datasets/).
scratch/
# Debris reproducible de randomTrips: escribe routes.rou.xml al cwd (raíz) por falta de
# output path explícito en generate_b1_demand.py (mitigación B3.2.c; root-cause diferido,
# ver documentation/ESTADO_Y_PROXIMOS_PASOS.md). Anclado a raíz (/): NO toca los .rou.xml
# legítimos de conf/scenarios/, conf/corredor_larco/, etc.
/routes.rou.xml
# Outputs regenerables del experimento de validación red-completa (F1, DHU-030): SUMO
# escribe tripinfo/summary.parquet acá. Se versionan demanda + sumocfg + README, NO los runs.
simulation/conf/miraflores_red_completa/runs/
# Capturas masivas de los streams Claro (monitoreo 24h, NO material curado de benchmark).
capturas_claro/
# Dumps de respaldo de la BD (pg_dump custom format). Binarios pesados, reproducibles
# vía pg_dump; NUNCA se versionan.
*.dump
# Output dir de hydra del edge_device (run vivo del servidor de visión): logs/configs
# por-corrida, regenerables. No es material versionable.
edge_device/outputs/
