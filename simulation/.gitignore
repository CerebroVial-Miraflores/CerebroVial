.venv/
__pycache__/
*.pyc
data/train/*.parquet
data/valid/*.parquet
data/kpis/
data/_coverage/
data/_e2e/
# Outputs del corredor Larco (ETAPA 2): baseline + barrido de demanda.
# Regenerables determinísticamente (seed fija) — kpis locales, no se versionan.
data/corredor_larco/
.env
*.parquet
# Datasets versionados: el .parquet ya lo ignora la regla global de arriba.
# Ignorar XML de muestra crudos (pesan cientos de MB), pero trackear el README
# para que la carpeta sea visible en git.
data/datasets/**/*.xml
!data/datasets/miraflores_laborable_60d/README.md
# Tensores consolidados del builder STGNN (regenerables desde los Parquet,
# voluminosos). El metadata.json y el README de tensors/ SÍ se versionan.
data/datasets/**/*.npz
# Intermediarios de build_network.py (regenerables desde el YAML).
conf/network/_generated_*.xml
# Outputs SUMO en conf/network/ (generados accidentalmente por corridas
# fuera del out_dir esperado — coverage_check.py copia add-files al out_dir
# para que esto no pase).
conf/network/edgedata.xml
conf/network/lanearea.xml
!data/.gitkeep
