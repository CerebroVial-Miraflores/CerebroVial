# SUMO_HOME — apuntar al wheel de eclipse-sumo instalado en simulation/.venv/
# Resuelve al directorio que contenga bin/, tools/, data/ — i.e. site-packages/sumo/
SUMO_HOME=$(pwd)/.venv/lib/python3.11/site-packages/sumo

# Engine HTTP (motor adaptativo del core_management_api, lockeado en puerto 8001)
# Requiere `invoke up` (o equivalente) en otra terminal para corridas e2e (F4/F5).
ENGINE_URL=http://localhost:8001/control/recommend

# PATH — agregá $SUMO_HOME/bin al inicio para resolver sumo/sumo-gui/netgenerate/duarouter
# desde el wheel, no del framework system-wide.
# PATH=$SUMO_HOME/bin:$PATH
