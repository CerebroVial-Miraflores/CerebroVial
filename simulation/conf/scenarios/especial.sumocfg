<?xml version="1.0" encoding="UTF-8"?>
<!-- especial: perfil-día de 24h (TTH-11), evento atípico con meseta alta sostenida (jam 4).
     Set desacoplado de TTH-07 — net 4-way, end=86400, rutas fásicas. -->
<configuration>
  <input>
    <net-file value="../network/miraflores_4way.net.xml"/>
    <route-files value="routes/especial.rou.xml"/>
    <additional-files value="../network/miraflores_4way.tllogic.add.xml,../network/edgedata.add.xml,../network/lanearea.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="86400"/>
    <step-length value="1"/>
  </time>
  <report>
    <no-step-log value="true"/>
    <no-warnings value="true"/>
  </report>
</configuration>
