<?xml version="1.0" encoding="UTF-8"?>
<!-- pm_peak: hora pico vespertina, target jam ≥3. -->
<configuration>
  <input>
    <net-file value="../network/miraflores_4way.net.xml"/>
    <route-files value="routes/pm_peak.rou.xml"/>
    <additional-files value="../network/miraflores_4way.tllogic.add.xml,../network/edgedata.add.xml,../network/lanearea.add.xml"/>
  </input>
  <time>
    <begin value="0"/>
    <end value="1200"/>
    <step-length value="1"/>
  </time>
  <report>
    <no-step-log value="true"/>
    <no-warnings value="true"/>
  </report>
</configuration>
